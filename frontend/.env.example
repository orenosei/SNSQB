# Leave unset for browser deployments and local Vite development. Requests use
# the same-origin /api/v1 path, which is proxied by Vite locally and Vercel in production.
# VITE_API_BASE_URL=https://snsqb.duckdns.org/api/v1

# Export these in the shell for real API tests with your existing account.
# The api-real Playwright project loads this .env automatically. Never use VITE_ for credentials.
# SNSQB_TEST_EMAIL=
# SNSQB_TEST_PASSWORD=
# SNSQB_TEST_API_BASE_URL=https://snsqb.duckdns.org/api/v1
# Chỉ đặt khi backend cho phép origin frontend dùng để chạy E2E STOMP thật.
# SNSQB_REALTIME_E2E_ORIGIN=

# Optional: peer tests need a second account of the same role with no existing relationship.
# SNSQB_TEST_PEER_EMAIL=
# SNSQB_TEST_PEER_PASSWORD=

# Academic API tests: a STUDENT account; proposal class is discovered when possible.
# SNSQB_TEST_SUBJECT_ID=
# SNSQB_TEST_PROPOSAL_CLASS_ID=
# SNSQB_TEST_APPROVED_SESSION_ID=
# SNSQB_TEST_UNANSWERED_QUESTION_ID=
# Optional second STUDENT uses SNSQB_TEST_PEER_EMAIL/PASSWORD above.
# Optional LECTURER for review/exam tests:
# SNSQB_TEST_LECTURER_EMAIL=
# SNSQB_TEST_LECTURER_PASSWORD=
# SNSQB_TEST_ACADEMIC_CLASS_ID=
# Answers, ratings, reviewed sessions, and exams have no reset/delete API.
