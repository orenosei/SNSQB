VITE_API_BASE_URL=https://snsqb.duckdns.org/api/v1

# Export these in the shell for real API tests with a dedicated account.
# Playwright does not load .env. Never use VITE_ for credentials.
# SNSQB_RUN_REAL_API=1
# SNSQB_TEST_EMAIL=
# SNSQB_TEST_PASSWORD=
# SNSQB_TEST_API_BASE_URL=https://snsqb.duckdns.org/api/v1

# Additional opt-in for social API mutations on an isolated pair of dedicated accounts.
# Both accounts must have the same STUDENT/LECTURER role and no existing mutual relations.
# Export these variables in your shell (never put credentials in VITE_*).
# SNSQB_RUN_REAL_SOCIAL=1
# SNSQB_TEST_PEER_EMAIL=
# SNSQB_TEST_PEER_PASSWORD=
