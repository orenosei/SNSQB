{
  "name": "snsqb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src tests *.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test --project=ui-desktop --project=ui-mobile",
    "test:api": "playwright test --project=api-real"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.0"
  }
}
